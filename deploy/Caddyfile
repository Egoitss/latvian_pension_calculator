# Caddy auto-provisions a Let's Encrypt certificate for this domain,
# as long as pension.oats.lv resolves to the server and 80/443 are open.
{
	email info@oats.lv
}

# RFC 9116 security.txt, served from the proxy so neither app needs
# a route for it. {args[0]} is the site's canonical URL.
(security_txt) {
	handle /.well-known/security.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond `Contact: mailto:info@oats.lv
Expires: 2027-06-30T00:00:00.000Z
Preferred-Languages: lv, en
Canonical: {args[0]}
` 200
	}
}

pension.oats.lv {
	# HSTS: force HTTPS for 2 years (flagged missing by
	# securityheaders.com)
	header Strict-Transport-Security "max-age=63072000; includeSubDomains"
	# Permissions-Policy: deny powerful browser features the site
	# never uses (same baseline as oats.lv).
	header Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()"

	# Access log (JSON) for visit counts. Rotated so it can't fill
	# the disk; persisted via the caddy_logs volume in compose.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
	# Reject methods the app doesn't use. POST must stay: the PDF
	# export (/export/pdf) and AI review (/api/recommend) are POST.
	# NOTE: this also rejects CORS preflight (OPTIONS) — if the API
	# is ever opened cross-origin, exempt /api/* from this matcher
	# and answer preflights with proper CORS headers.
	@badMethod not method GET HEAD POST
	handle @badMethod {
		header Allow "GET, HEAD, POST"
		respond "Method Not Allowed" 405
	}

	import security_txt https://pension.oats.lv/.well-known/security.txt

	reverse_proxy pension:5001
}

# BMX report app — separate repo (/srv/oats/bmx on the server); its
# containers join this Caddy's docker network. This block lives here
# because this Caddyfile is the single front proxy for the host.
bmx.oats.lv {
	header Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()"

	# Same method allowlist as pension: bmx uses POST for
	# /generate and /generate.pdf. See CORS note above.
	@badMethod not method GET HEAD POST
	handle @badMethod {
		header Allow "GET, HEAD, POST"
		respond "Method Not Allowed" 405
	}

	import security_txt https://bmx.oats.lv/.well-known/security.txt

	reverse_proxy bmx-web:8000
}
